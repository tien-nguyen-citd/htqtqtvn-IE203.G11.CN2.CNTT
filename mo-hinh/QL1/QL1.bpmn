        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:callActivity>
      <bpmn:exclusiveGateway id="C5" name="Số phiếu được đại diện ở lần họp thứ nhất có trên 50%?">
        <bpmn:incoming>F_B16_C5</bpmn:incoming>
        <bpmn:outgoing>F_C5_M5</bpmn:outgoing>
        <bpmn:outgoing>F_C5_B17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="M5" name="Điều kiện tiến hành đại hội đã được đáp ứng">
        <bpmn:incoming>F_C5_M5</bpmn:incoming>
        <bpmn:incoming>F_M6_M5</bpmn:incoming>
        <bpmn:outgoing>F_M5_B21</bpmn:outgoing>
