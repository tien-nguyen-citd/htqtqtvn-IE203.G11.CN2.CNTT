<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_QL1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="coursework/tools/bpmn/builder.ts" exporterVersion="1.0">
  <bpmn:collaboration id="QL1">
    <bpmn:participant id="P_CoDong" name="Cổ đông hoặc người đại diện" />
    <bpmn:participant id="P_VNA" name="VNA" processRef="P_VNA_Process" />
    <bpmn:messageFlow id="Tin_MoiHop" name="Thông báo mời họp" sourceRef="B3" targetRef="P_CoDong" />
    <bpmn:messageFlow id="Tin_MoiHopLai" name="Thông báo mời họp lại" sourceRef="B4" targetRef="P_CoDong" />
    <bpmn:messageFlow id="Tin_DangKy" name="Hồ sơ đăng ký dự họp" sourceRef="P_CoDong" targetRef="B4" />
    <bpmn:messageFlow id="Tin_BieuQuyet" name="Phiếu biểu quyết" sourceRef="P_CoDong" targetRef="B5a" />
    <bpmn:messageFlow id="Tin_KetQua" name="Kết quả biểu quyết" sourceRef="B8" targetRef="P_CoDong" />
  </bpmn:collaboration>
  <bpmn:process id="P_VNA_Process" isExecutable="false">
    <bpmn:laneSet id="P_VNA_Process_LaneSet">
      <bpmn:lane id="L_KeHoach" name="Bộ phận lập kế hoạch">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ToChuc" name="Tổ chức đại hội">
        <bpmn:flowNodeRef>B2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B41</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B39</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B40</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ChuToa" name="Chủ tọa và Thư ký">
        <bpmn:flowNodeRef>B5a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_KiemPhieu" name="Ban kiểm phiếu">
        <bpmn:flowNodeRef>B5b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Năm tài chính đã kết thúc">
      <bpmn:outgoing>F_S_B1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="B1" name="Lập dự thảo chỉ tiêu sản xuất kinh doanh năm">
      <bpmn:incoming>F_S_B1</bpmn:incoming>
      <bpmn:outgoing>F_B1_B2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B2" name="Chuẩn bị hồ sơ trình kế hoạch năm">
      <bpmn:documentation>Nhận tờ trình và nghị quyết HĐQT thông qua việc trình từ kết thúc K1b của QL2 khi hồ sơ là bộ chỉ tiêu sản xuất kinh doanh năm đưa ra Đại hội đồng cổ đông thường niên.</bpmn:documentation>
      <bpmn:incoming>F_B1_B2</bpmn:incoming>
      <bpmn:outgoing>F_B2_C9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B41" name="Mời đại diện tổ chức kiểm toán dự họp">
      <bpmn:incoming>F_C9_B41</bpmn:incoming>
      <bpmn:outgoing>F_B41_M9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B5a" name="Trình kế hoạch năm để đại hội biểu quyết">
      <bpmn:incoming>F_B4_B5a</bpmn:incoming>
      <bpmn:outgoing>F_B5a_B5b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B5b" name="Kiểm phiếu biểu quyết kế hoạch năm">
      <bpmn:incoming>F_B5a_B5b</bpmn:incoming>
      <bpmn:outgoing>F_B5b_C7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B6" name="Xác nhận kế hoạch năm đã được thông qua">
      <bpmn:incoming>F_C7_B6</bpmn:incoming>
      <bpmn:outgoing>F_B6_M7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B7" name="Xác nhận kế hoạch năm chưa được thông qua">
      <bpmn:incoming>F_C7_B7</bpmn:incoming>
      <bpmn:outgoing>F_B7_M7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B39" name="Công bố và lưu hồ sơ biểu quyết kế hoạch năm">
      <bpmn:incoming>F_D1_B39</bpmn:incoming>
      <bpmn:outgoing>F_B39_K1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B40" name="Công bố và lưu biên bản về kế hoạch chưa thông qua">
      <bpmn:incoming>F_D1_B40</bpmn:incoming>
      <bpmn:outgoing>F_B40_K2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="K1" name="Nghị quyết về kế hoạch năm đã được công bố">
      <bpmn:incoming>F_B39_K1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="K2" name="Kế hoạch năm đã không được ĐHĐCĐ thông qua">
      <bpmn:incoming>F_B40_K2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="K3" name="Hồ sơ biểu quyết kế hoạch năm đã không đủ điều kiện ký">
      <bpmn:incoming>F_D1_K3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="B3" name="Chuẩn bị và gửi thông báo mời họp">
      <bpmn:incoming>F_M9_B3</bpmn:incoming>
      <bpmn:outgoing>F_B3_B4</bpmn:outgoing>
      <bpmn:laneSet id="Lanes_B3">
        <bpmn:lane id="L_B3_1" name="Tổ chức đại hội">
          <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B9</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B10</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B11</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B12</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B13</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B14</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B15</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Z1</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="S1" name="Hồ sơ trình kế hoạch năm đã được chuẩn bị">
        <bpmn:outgoing>F_S1_B9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="B9" name="Xác định nhu cầu gia hạn đại hội">
        <bpmn:incoming>F_S1_B9</bpmn:incoming>
        <bpmn:outgoing>F_B9_C1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="B10" name="Ấn định ngày họp trong hạn thường niên">
        <bpmn:incoming>F_C1_B10</bpmn:incoming>
        <bpmn:outgoing>F_B10_M1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="B11" name="Quyết định gia hạn ngày họp">
        <bpmn:incoming>F_C1_B11</bpmn:incoming>
        <bpmn:outgoing>F_B11_M1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="B12" name="Chốt danh sách cổ đông và phương án gửi tài liệu">
        <bpmn:incoming>F_M1_B12</bpmn:incoming>
        <bpmn:outgoing>F_B12_C2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="B13" name="Đính kèm tài liệu vào thông báo mời họp">
        <bpmn:incoming>F_C2_B13</bpmn:incoming>
        <bpmn:outgoing>F_B13_M2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="B14" name="Ghi đường dẫn đến toàn bộ tài liệu họp">
        <bpmn:incoming>F_C2_B14</bpmn:incoming>
        <bpmn:outgoing>F_B14_M2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="B15" name="Gửi và công bố thông báo mời họp">
        <bpmn:incoming>F_M2_B15</bpmn:incoming>
        <bpmn:outgoing>F_B15_Z1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Z1" name="Thông báo mời họp đã được gửi và công bố">
        <bpmn:incoming>F_B15_Z1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="C1" name="ĐHĐCĐ thường niên cần gia hạn thời điểm họp?">
        <bpmn:incoming>F_B9_C1</bpmn:incoming>
        <bpmn:outgoing>F_C1_B10</bpmn:outgoing>
        <bpmn:outgoing>F_C1_B11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="M1" name="Ngày họp đã được xác định">
        <bpmn:incoming>F_B10_M1</bpmn:incoming>
        <bpmn:incoming>F_B11_M1</bpmn:incoming>
        <bpmn:outgoing>F_M1_B12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="C2" name="Tài liệu họp được gửi kèm thông báo?">
        <bpmn:incoming>F_B12_C2</bpmn:incoming>
        <bpmn:outgoing>F_C2_B13</bpmn:outgoing>
        <bpmn:outgoing>F_C2_B14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="M2" name="Thông báo mời họp đã có cách truy cập tài liệu">
        <bpmn:incoming>F_B13_M2</bpmn:incoming>
        <bpmn:incoming>F_B14_M2</bpmn:incoming>
        <bpmn:outgoing>F_M2_B15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="F_S1_B9" sourceRef="S1" targetRef="B9" />
      <bpmn:sequenceFlow id="F_B9_C1" sourceRef="B9" targetRef="C1" />
      <bpmn:sequenceFlow id="F_C1_B10" name="Không cần" sourceRef="C1" targetRef="B10">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không cần</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_C1_B11" name="Cần" sourceRef="C1" targetRef="B11">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Cần</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_B10_M1" sourceRef="B10" targetRef="M1" />
      <bpmn:sequenceFlow id="F_B11_M1" sourceRef="B11" targetRef="M1" />
      <bpmn:sequenceFlow id="F_M1_B12" sourceRef="M1" targetRef="B12" />
      <bpmn:sequenceFlow id="F_B12_C2" sourceRef="B12" targetRef="C2" />
      <bpmn:sequenceFlow id="F_C2_B13" name="Có" sourceRef="C2" targetRef="B13">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_C2_B14" name="Không" sourceRef="C2" targetRef="B14">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_B13_M2" sourceRef="B13" targetRef="M2" />
      <bpmn:sequenceFlow id="F_B14_M2" sourceRef="B14" targetRef="M2" />
      <bpmn:sequenceFlow id="F_M2_B15" sourceRef="M2" targetRef="B15" />
      <bpmn:sequenceFlow id="F_B15_Z1" sourceRef="B15" targetRef="Z1" />
    </bpmn:subProcess>
    <bpmn:subProcess id="B4" name="Kiểm tra điều kiện tiến hành đại hội">
      <bpmn:incoming>F_B3_B4</bpmn:incoming>
      <bpmn:outgoing>F_B4_B5a</bpmn:outgoing>
      <bpmn:laneSet id="Lanes_B4">
        <bpmn:lane id="L_B4_1" name="Tổ chức đại hội">
          <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B17</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B19</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B16</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B18</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B20</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>C5</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>M5</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>C6</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>M6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_B4_2" name="Chủ tọa và Thư ký">
          <bpmn:flowNodeRef>B21</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Z2</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="S2" name="Đại hội đã được triệu tập">
        <bpmn:outgoing>F_S2_B16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="B17" name="Gửi thông báo mời họp lần thứ hai">
        <bpmn:incoming>F_C5_B17</bpmn:incoming>
        <bpmn:outgoing>F_B17_B18</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="B19" name="Gửi thông báo mời họp lần thứ ba">
        <bpmn:incoming>F_C6_B19</bpmn:incoming>
        <bpmn:outgoing>F_B19_B20</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="B21" name="Khai mạc đại hội để biểu quyết kế hoạch năm">
        <bpmn:incoming>F_M5_B21</bpmn:incoming>
        <bpmn:outgoing>F_B21_Z2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Z2" name="Đại hội đã được khai mạc">
        <bpmn:incoming>F_B21_Z2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:callActivity id="B16" name="Kiểm tra tư cách cổ đông dự họp lần thứ nhất" calledElement="Process_TuCachCoDong">
        <bpmn:documentation>Kiểm tra lần lượt từng hồ sơ đăng ký của lần họp này và tổng hợp tư cách, số phiếu sau khi hoàn tất toàn bộ danh sách.</bpmn:documentation>
        <bpmn:incoming>F_S2_B16</bpmn:incoming>
        <bpmn:outgoing>F_B16_C5</bpmn:outgoing>
        <bpmn:ioSpecification>
          <bpmn:dataInput id="DanhSachHoSo_B16" name="Danh sách hồ sơ đăng ký dự họp" isCollection="true" />
          <bpmn:inputSet>
            <bpmn:dataInputRefs>DanhSachHoSo_B16</bpmn:dataInputRefs>
          </bpmn:inputSet>
          <bpmn:outputSet />
        </bpmn:ioSpecification>
        <bpmn:multiInstanceLoopCharacteristics id="MI_B16" isSequential="true">
          <bpmn:loopDataInputRef>DanhSachHoSo_B16</bpmn:loopDataInputRef>
          <bpmn:inputDataItem id="HoSo_B16" name="Hồ sơ đăng ký dự họp của cổ đông" />
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:callActivity>
      <bpmn:callActivity id="B18" name="Kiểm tra tư cách cổ đông dự họp lần thứ hai" calledElement="Process_TuCachCoDong">
        <bpmn:documentation>Kiểm tra lần lượt từng hồ sơ đăng ký của lần họp này và tổng hợp tư cách, số phiếu sau khi hoàn tất toàn bộ danh sách.</bpmn:documentation>
        <bpmn:incoming>F_B17_B18</bpmn:incoming>
        <bpmn:outgoing>F_B18_C6</bpmn:outgoing>
        <bpmn:ioSpecification>
          <bpmn:dataInput id="DanhSachHoSo_B18" name="Danh sách hồ sơ đăng ký dự họp" isCollection="true" />
