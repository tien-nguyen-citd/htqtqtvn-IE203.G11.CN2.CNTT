        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:callActivity>
      <bpmn:callActivity id="B20" name="Kiểm tra tư cách cổ đông dự họp lần thứ ba" calledElement="Process_TuCachCoDong">
        <bpmn:documentation>Kiểm tra lần lượt từng hồ sơ đăng ký của lần họp này và tổng hợp tư cách, số phiếu sau khi hoàn tất toàn bộ danh sách.</bpmn:documentation>
        <bpmn:incoming>F_B19_B20</bpmn:incoming>
        <bpmn:outgoing>F_B20_M6</bpmn:outgoing>
        <bpmn:ioSpecification>
          <bpmn:dataInput id="DanhSachHoSo_B20" name="Danh sách hồ sơ đăng ký dự họp" isCollection="true" />
