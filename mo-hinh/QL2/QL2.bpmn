        <bpmn:outgoing>F_C6_B34</bpmn:outgoing>
        <bpmn:outgoing>F_C6_Z3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Z2a" name="Lần họp thứ nhất đã đủ điều kiện tiến hành">
        <bpmn:incoming>F_B20_Z2a</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="Z2b" name="Lần họp thứ hai đã đủ điều kiện tiến hành">
