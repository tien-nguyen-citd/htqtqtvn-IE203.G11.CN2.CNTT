      <bpmn:sequenceFlow id="F_B15_M1" sourceRef="B15" targetRef="M1" />
      <bpmn:sequenceFlow id="F_B16_M1" sourceRef="B16" targetRef="M1" />
      <bpmn:sequenceFlow id="F_M1_B35" sourceRef="M1" targetRef="B35" />
      <bpmn:sequenceFlow id="F_B35_Z1" sourceRef="B35" targetRef="Z1" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="C2" name="Ai triệu tập?">
      <bpmn:incoming>F_B2_C2</bpmn:incoming>
      <bpmn:outgoing>F_C2_M2</bpmn:outgoing>
      <bpmn:outgoing>F_C2_B5</bpmn:outgoing>
      <bpmn:outgoing>F_C2_K5</bpmn:outgoing>
