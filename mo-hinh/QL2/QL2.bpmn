      <bpmn:incoming>F_C2_K5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="B6" name="Xác định điều kiện tiến hành cuộc họp HĐQT">
      <bpmn:documentation>Trả kết quả đủ điều kiện ở lần thứ nhất hoặc lần thứ hai, hoặc lần thứ hai không đủ điều kiện. Đ1 chỉ cho kiểm phiếu khi một lần họp đủ điều kiện tiến hành.</bpmn:documentation>
      <bpmn:incoming>F_M2_B6</bpmn:incoming>
      <bpmn:outgoing>F_B6_D1</bpmn:outgoing>
      <bpmn:laneSet id="Lanes_B6">
        <bpmn:lane id="L_B6_1" name="Chủ tịch HĐQT">
          <bpmn:flowNodeRef>B18</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B20</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B34</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Z2a</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Z2b</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_B6_2" name="Thư ký cuộc họp">
          <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B17</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B19</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>C5</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>C6</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Z3</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="S2" name="Thông báo họp HĐQT đã được gửi">
        <bpmn:outgoing>F_S2_B17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:callActivity id="B17" name="Ghi tư cách thành viên dự họp lần thứ nhất" calledElement="Process_TuCach">
        <bpmn:documentation>Tổng hợp số thành viên đủ tư cách của lần họp sau khi xét lần lượt từng thành viên.</bpmn:documentation>
      <bpmn:incoming>F_S2_B17</bpmn:incoming>
      <bpmn:outgoing>F_B17_C5</bpmn:outgoing>
        <bpmn:ioSpecification>
          <bpmn:dataInput id="DanhSachThanhVien_B17" name="Danh sách thành viên dự họp" isCollection="true" />
          <bpmn:inputSet><bpmn:dataInputRefs>DanhSachThanhVien_B17</bpmn:dataInputRefs></bpmn:inputSet>
          <bpmn:outputSet />
        </bpmn:ioSpecification>
        <bpmn:multiInstanceLoopCharacteristics id="MI_B17" isSequential="true">
          <bpmn:loopDataInputRef>DanhSachThanhVien_B17</bpmn:loopDataInputRef>
          <bpmn:inputDataItem id="ThanhVien_B17" name="Thành viên dự họp" />
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:callActivity>
      <bpmn:callActivity id="B19" name="Ghi tư cách thành viên dự họp lần thứ hai" calledElement="Process_TuCach">
        <bpmn:documentation>Tổng hợp số thành viên đủ tư cách của lần họp sau khi xét lần lượt từng thành viên.</bpmn:documentation>
      <bpmn:incoming>F_B18_B19</bpmn:incoming>
      <bpmn:outgoing>F_B19_C6</bpmn:outgoing>
        <bpmn:ioSpecification>
          <bpmn:dataInput id="DanhSachThanhVien_B19" name="Danh sách thành viên dự họp" isCollection="true" />
          <bpmn:inputSet><bpmn:dataInputRefs>DanhSachThanhVien_B19</bpmn:dataInputRefs></bpmn:inputSet>
          <bpmn:outputSet />
        </bpmn:ioSpecification>
        <bpmn:multiInstanceLoopCharacteristics id="MI_B19" isSequential="true">
          <bpmn:loopDataInputRef>DanhSachThanhVien_B19</bpmn:loopDataInputRef>
          <bpmn:inputDataItem id="ThanhVien_B19" name="Thành viên dự họp" />
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:callActivity>
      <bpmn:task id="B18" name="Triệu tập cuộc họp HĐQT lần thứ hai">
        <bpmn:incoming>F_C5_B18</bpmn:incoming>
        <bpmn:outgoing>F_B18_B19</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="B20" name="Xác nhận lần họp thứ nhất đủ điều kiện tiến hành">
        <bpmn:incoming>F_C5_B20</bpmn:incoming>
        <bpmn:outgoing>F_B20_Z2a</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="B34" name="Xác nhận lần họp thứ hai đủ điều kiện tiến hành">
        <bpmn:incoming>F_C6_B34</bpmn:incoming>
        <bpmn:outgoing>F_B34_Z2b</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="C5" name="Lần đầu đủ 3/4?">
        <bpmn:incoming>F_B17_C5</bpmn:incoming>
        <bpmn:outgoing>F_C5_B20</bpmn:outgoing>
        <bpmn:outgoing>F_C5_B18</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="C6" name="Lần hai có hơn một nửa?">
