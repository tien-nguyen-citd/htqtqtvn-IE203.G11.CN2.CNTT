      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_B20_Z2a" sourceRef="B20" targetRef="Z2a" />
      <bpmn:sequenceFlow id="F_B18_B19" sourceRef="B18" targetRef="B19" />
      <bpmn:sequenceFlow id="F_B19_C6" sourceRef="B19" targetRef="C6" />
      <bpmn:sequenceFlow id="F_C6_B34" name="Hơn một nửa" sourceRef="C6" targetRef="B34">
