          <bpmn:flowNodeRef>B13</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B14</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B15</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>B35</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Z1</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_B2_2" name="Thành viên HĐQT và đầu mối đề nghị">
          <bpmn:flowNodeRef>B16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="S1" name="Đề nghị họp hợp lệ đã được xác nhận">
        <bpmn:outgoing>F_S1_B13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="B13" name="Kiểm tra người có thể thực hiện quyền chủ tịch">
        <bpmn:incoming>F_S1_B13</bpmn:incoming>
        <bpmn:outgoing>F_B13_C1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="C1" name="Ai giữ quyền Chủ tịch?">
        <bpmn:incoming>F_B13_C1</bpmn:incoming>
        <bpmn:outgoing>F_C1_B14</bpmn:outgoing>
        <bpmn:outgoing>F_C1_B15</bpmn:outgoing>
        <bpmn:outgoing>F_C1_B16</bpmn:outgoing>
      </bpmn:exclusiveGateway>
