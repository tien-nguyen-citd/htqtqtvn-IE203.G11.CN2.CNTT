        <bpmn:incoming>F_C1_B15</bpmn:incoming>
        <bpmn:outgoing>F_B15_M1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="B16" name="Bầu thành viên tạm giữ chức Chủ tịch HĐQT">
        <bpmn:incoming>F_C1_B16</bpmn:incoming>
        <bpmn:outgoing>F_B16_M1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="M1" name="Tình trạng người thực hiện quyền chủ tịch đã được ghi">
        <bpmn:incoming>F_B14_M1</bpmn:incoming>
        <bpmn:incoming>F_B15_M1</bpmn:incoming>
        <bpmn:incoming>F_B16_M1</bpmn:incoming>
        <bpmn:outgoing>F_M1_B35</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="B35" name="Đối chiếu việc triệu tập họp trong thời hạn">
        <bpmn:incoming>F_M1_B35</bpmn:incoming>
        <bpmn:outgoing>F_B35_Z1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Z1" name="Kết quả đối chiếu thời hạn triệu tập đã được ghi nhận">
        <bpmn:incoming>F_B35_Z1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F_S1_B13" sourceRef="S1" targetRef="B13" />
      <bpmn:sequenceFlow id="F_B13_C1" sourceRef="B13" targetRef="C1" />
      <bpmn:sequenceFlow id="F_C1_B14" name="Chủ tịch" sourceRef="C1" targetRef="B14">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Chủ tịch</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_C1_B15" name="Có văn bản ủy quyền" sourceRef="C1" targetRef="B15">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có văn bản ủy quyền</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
