    <bpmn:exclusiveGateway id="D1" name="Đủ điều kiện?">
      <bpmn:incoming>F_B6_D1</bpmn:incoming>
      <bpmn:outgoing>F_D1_B7</bpmn:outgoing>
      <bpmn:outgoing>F_D1_K3</bpmn:outgoing>
