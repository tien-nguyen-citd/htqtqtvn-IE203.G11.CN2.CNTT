    <bpmn:startEvent id="S" name="Đề nghị họp về chủ trương, chính sách đã được tiếp nhận">
      <bpmn:outgoing>F_S_B1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="B1" name="Kiểm tra đề nghị họp về chủ trương, chính sách">
      <bpmn:incoming>F_S_B1</bpmn:incoming>
      <bpmn:outgoing>F_B1_C9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="C9" name="Nội dung thuộc thẩm quyền của ai?">
      <bpmn:incoming>F_B1_C9</bpmn:incoming>
      <bpmn:outgoing>F_C9_M9</bpmn:outgoing>
      <bpmn:outgoing>F_C9_B38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="B38" name="Lập tờ trình Đại hội đồng cổ đông">
